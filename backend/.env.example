# ---------------------------------------------------------------------------
# Backend configuration.  Copy this file to .env and edit.
# ---------------------------------------------------------------------------
# Every value below has a working default in code, so the server starts even
# with no .env at all — except JWT_SECRET, which you should always change.

PORT=4000
NODE_ENV=development

# --- MySQL -----------------------------------------------------------------
# Docker Compose supplies the container values. These defaults are for running
# the backend directly on the host during development.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_cafeteria
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=8000

# --- Authentication --------------------------------------------------------
# Change this.  Anyone who knows it can mint a token for any role, including
# admin.  Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# --- CORS ------------------------------------------------------------------
# Comma-separated allow-list for local frontend origins.
# Add your machine's LAN address (e.g. http://192.168.1.20) to test on a phone.
CORS_ORIGIN=http://localhost,http://localhost:5173

# Number of trusted proxies in front of this server; 0 when connecting directly.
TRUST_PROXY_HOPS=1

# --- DES engine ------------------------------------------------------------
# The Python/SimPy service in ../des-engine.  If it is not running, wait times
# fall back to a simple average-rate estimate and /api/simulations returns 503
# with an instruction rather than failing silently (NFR-09).
DES_ENGINE_URL=http://127.0.0.1:5001
# Must match DES_API_KEY in the DES engine configuration if you set one.
DES_API_KEY=

# How long to wait for each kind of call.  The estimate budget is short because
# a student is staring at the queue banner while it runs; the simulate budget
# is long because the manager clicked a button and expects it to take a moment.
DES_ESTIMATE_TIMEOUT_MS=1500
DES_SIMULATE_TIMEOUT_MS=25000

# Circuit breaker: after this many consecutive failures the engine is bypassed
# entirely for the cooldown period, so an engine that is down costs one slow
# request rather than every request.
DES_FAILURE_THRESHOLD=3
DES_BREAKER_COOLDOWN_MS=20000

# --- Queue history ---------------------------------------------------------
# Minimum gap between persisted queue snapshots.  Without this, every student
# with the page open writes a row per poll, which bloats the table and skews
# every average computed from it.
QUEUE_SNAPSHOT_INTERVAL_MS=5000

# --- Serving the built frontend (optional) ---------------------------------
# If frontend/dist exists, the API also serves it. This must match the
# VITE_BASE_PATH used at build time.
FRONTEND_BASE_PATH=/smart-cafeteria/
