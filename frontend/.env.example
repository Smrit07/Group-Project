# ---------------------------------------------------------------------------
# Frontend configuration.  Copy to .env.
# ---------------------------------------------------------------------------
# Leave both API values EMPTY for the XAMPP deployment: the app then calls
# /api and /socket.io on its own origin, which Apache reverse-proxies to Node.
# That is what lets the same build work on localhost and on a campus server
# without being rebuilt.
VITE_API_BASE=
VITE_SOCKET_URL=

# Where the built app will live under htdocs.  Must end with a slash.
#   served at http://localhost/smart-cafeteria/  ->  /smart-cafeteria/
#   served at http://localhost/                  ->  /
VITE_BASE_PATH=/smart-cafeteria/

# Dev server only: where `npm run dev` proxies /api and /socket.io to.
VITE_DEV_API_TARGET=http://localhost:4000
