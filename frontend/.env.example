# ---------------------------------------------------------------------------
# Frontend configuration.  Copy to .env.
# ---------------------------------------------------------------------------
# Leave both API values empty to use relative URLs on the app's origin.
VITE_API_BASE=
VITE_SOCKET_URL=

# The Docker app is served from the web root.
VITE_BASE_PATH=/

# Dev server only: where `npm run dev` proxies /api and /socket.io to.
VITE_DEV_API_TARGET=http://localhost:4000
