# ---------------------------------------------------------------------------
# DES engine configuration.  Copy to .env and edit; every value has a sane
# default, so an empty .env still runs.
# ---------------------------------------------------------------------------

# --- HTTP ---
DES_HOST=127.0.0.1
DES_PORT=5001
DES_DEBUG=false
# Leave DES_API_KEY unset for local XAMPP use.  If set, the Express backend
# must send the same value in DES_API_KEY (backend/.env).
# DES_API_KEY=

# --- MySQL (XAMPP defaults: user root, empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_cafeteria
DB_CONNECT_TIMEOUT=4

# --- Calibration ---
DES_USE_DB_CALIBRATION=true
DES_CALIBRATION_TTL_SECONDS=600
DES_CALIBRATION_MIN_SAMPLES=30

# --- Model parameters (measured during the Sprint 1 timed observations) ---
DES_SERVICE_MEAN_MINUTES=2.5
DES_SERVICE_CV=0.45
DES_PICKUP_MEAN_MINUTES=0.6
DES_PICKUP_CV=0.35
DES_PREORDER_SHARE=0.0
DES_BALK_TOLERANCE=18
DES_BALK_STEEPNESS=0.45
DES_HORIZON_MINUTES=60
DES_WARMUP_MINUTES=5
# Six 10-minute bins across the 09:00-10:00 break.
DES_ARRIVAL_MULTIPLIERS=0.35,1.00,1.45,1.20,0.80,0.45

# --- Run control ---
DES_SCENARIO_REPLICATIONS=30
DES_ESTIMATE_REPLICATIONS=8
DES_MAX_REPLICATIONS=200
DES_MAX_RUNTIME_SECONDS=20
DES_ESTIMATE_CACHE_TTL_SECONDS=20
# Fixed so a demo reproduces the numbers in the report's screenshots.
DES_BASE_SEED=20261007
